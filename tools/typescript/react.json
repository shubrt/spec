{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./core.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": true
  }
}
