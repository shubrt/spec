{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entity": {
      "type": "string",
      "const": "epic"
    },
    "schema_version": {
      "type": "string",
      "const": "pm.epic.v2"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "archived"]
        }
      },
      "required": ["title", "status"],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "The standing business capability this epic represents. Not a deliverable and not time-boxed."
        },
        "business_problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "scope": {
          "description": "The long-horizon scope of the capability, not the scope of any one change.",
          "type": "object",
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^SCP-[1-9][0-9]*$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": ["stated", "verified", "inferred", "assumed"]
                      },
                      "source_ids": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^SRC-[1-9][0-9]*$"
                        }
                      }
                    },
                    "required": ["basis"],
                    "additionalProperties": false,
                    "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
                  }
                },
                "required": ["id", "statement"],
                "additionalProperties": false
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^SCP-[1-9][0-9]*$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": ["stated", "verified", "inferred", "assumed"]
                      },
                      "source_ids": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^SRC-[1-9][0-9]*$"
                        }
                      }
                    },
                    "required": ["basis"],
                    "additionalProperties": false,
                    "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
                  }
                },
                "required": ["id", "statement"],
                "additionalProperties": false
              }
            }
          },
          "required": ["included", "excluded"],
          "additionalProperties": false
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^OUT-[1-9][0-9]*$"
              },
              "outcome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "indicator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["stated", "verified", "inferred", "assumed"]
                  },
                  "source_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^SRC-[1-9][0-9]*$"
                    }
                  }
                },
                "required": ["basis"],
                "additionalProperties": false,
                "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
              }
            },
            "required": ["id", "outcome"],
            "additionalProperties": false
          }
        },
        "success_metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^MET-[1-9][0-9]*$"
              },
              "metric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "baseline": {
                "type": "number"
              },
              "operator": {
                "type": "string",
                "enum": ["<", "<=", "=", ">=", ">"]
              },
              "target": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["stated", "verified", "inferred", "assumed"]
                  },
                  "source_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^SRC-[1-9][0-9]*$"
                    }
                  }
                },
                "required": ["basis"],
                "additionalProperties": false,
                "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
              }
            },
            "required": ["id", "metric", "operator", "target", "unit"],
            "additionalProperties": false
          }
        },
        "rule_applications": {
          "description": "Canonical project Rules that apply across this epic and its streams.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^RA-[1-9][0-9]*$"
              },
              "rule_key": {
                "type": "string",
                "pattern": "^(?:R-[1-9][0-9]*|\\$[a-z][a-z0-9_]{0,39})$"
              },
              "applies_when": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "application": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["stated", "verified", "inferred", "assumed"]
                  },
                  "source_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^SRC-[1-9][0-9]*$"
                    }
                  }
                },
                "required": ["basis"],
                "additionalProperties": false,
                "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
              }
            },
            "required": ["id", "rule_key"],
            "additionalProperties": false
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^OQ-[1-9][0-9]*$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["id", "question"],
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ASM-[1-9][0-9]*$"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source_ids": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SRC-[1-9][0-9]*$"
                }
              }
            },
            "required": ["id", "statement"],
            "additionalProperties": false
          }
        }
      },
      "required": ["purpose"],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SRC-[1-9][0-9]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "user_input",
                  "conversation",
                  "existing_code",
                  "documentation",
                  "external_reference"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "snapshot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "supersedes_source_ids": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SRC-[1-9][0-9]*$"
                }
              }
            },
            "required": ["id", "type", "reference"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Immutable local Sources cited by claim evidence. Put uncertainty in addressable content assumptions or open_questions, never in inferred document paths."
    }
  },
  "required": ["entity", "schema_version", "meta", "content", "links", "provenance"],
  "additionalProperties": false
}
