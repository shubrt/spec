{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entity": {
      "type": "string",
      "const": "task"
    },
    "schema_version": {
      "type": "string",
      "const": "pm.task.v2"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "ready", "in_progress", "blocked", "in_review", "done", "cancelled"]
        },
        "task_type": {
          "type": "string",
          "enum": ["implementation", "investigation", "migration", "testing", "review", "decision"]
        }
      },
      "required": ["title", "status", "task_type"],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "The technical goal, in one or two sentences. The one section a task cannot omit."
        },
        "implements": {
          "type": "object",
          "properties": {
            "stream_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "requirement_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:FR|NFR)-[1-9][0-9]*$"
              }
            },
            "acceptance_criteria_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^AC-[1-9][0-9]*$"
              }
            },
            "behavior_case_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^BC-[1-9][0-9]*$"
              }
            },
            "change_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^CHG-[1-9][0-9]*$"
              }
            },
            "hypothesis_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^HYP-[1-9][0-9]*$"
              }
            },
            "research_question_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^RQ-[1-9][0-9]*$"
              }
            },
            "success_criteria_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^SC-[1-9][0-9]*$"
              }
            },
            "decision_rule_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^DR-[1-9][0-9]*$"
              }
            },
            "investigation_question_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^IQ-[1-9][0-9]*$"
              }
            },
            "refactor_target_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^REF-[1-9][0-9]*$"
              }
            },
            "invariant_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^INV-[1-9][0-9]*$"
              }
            },
            "quality_goal_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^QG-[1-9][0-9]*$"
              }
            },
            "maintenance_goal_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^MG-[1-9][0-9]*$"
              }
            }
          },
          "required": ["stream_id"],
          "additionalProperties": false,
          "description": "[task_references_business_requirements] A Task at ready or beyond must carry its server-canonical parent stream_id and at least one typed target id allowed by that Stream type. Rule constraints alone do not satisfy readiness."
        },
        "constrained_by_rule_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:R-[1-9][0-9]*|\\$[a-z][a-z0-9_]{0,39})$"
          }
        },
        "technical_scope": {
          "type": "object",
          "properties": {
            "repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "services": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "data_models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          "additionalProperties": false
        },
        "implementation": {
          "type": "object",
          "properties": {
            "approach": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "technical_decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "decision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "alternatives_considered": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                },
                "required": ["decision", "reason"],
                "additionalProperties": false
              }
            }
          },
          "required": ["approach"],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "verification": {
          "description": "[ready_task_needs_definition_of_done] A task at status ready or beyond needs a technical definition of done: at least one entry in content.done_when and at least one in content.verification.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^VER-[1-9][0-9]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "unit_test",
                  "integration_test",
                  "e2e_test",
                  "manual_test",
                  "review",
                  "measurement"
                ]
              },
              "procedure": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "expected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["id", "type", "procedure", "expected"],
            "additionalProperties": false
          }
        },
        "done_when": {
          "description": "[ready_task_needs_definition_of_done] A task at status ready or beyond needs a technical definition of done: at least one entry in content.done_when and at least one in content.verification.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ASM-[1-9][0-9]*$"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source_ids": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SRC-[1-9][0-9]*$"
                }
              }
            },
            "required": ["id", "statement"],
            "additionalProperties": false
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^OQ-[1-9][0-9]*$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["id", "question"],
            "additionalProperties": false
          }
        }
      },
      "required": ["objective"],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "parent_stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["parent_stream_id"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SRC-[1-9][0-9]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "user_input",
                  "conversation",
                  "existing_code",
                  "documentation",
                  "external_reference"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "snapshot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "supersedes_source_ids": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SRC-[1-9][0-9]*$"
                }
              }
            },
            "required": ["id", "type", "reference"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Immutable local Sources cited by claim evidence. Put uncertainty in addressable content assumptions or open_questions, never in inferred document paths."
    },
    "execution": {
      "type": "object",
      "properties": {
        "estimate": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "type": "string",
              "enum": ["minutes", "hours", "days", "points"]
            },
            "confidence": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "required": ["value", "unit"],
          "additionalProperties": false
        },
        "assignee": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["user", "agent", "planner_agent", "executor_agent", "system"]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["type", "id"],
          "additionalProperties": false
        },
        "executor_kind": {
          "type": "string",
          "enum": ["human", "agent", "either"]
        },
        "execution_context": {
          "type": "object",
          "properties": {
            "environment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "additionalProperties": false
        },
        "long_running": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["entity", "schema_version", "meta", "content", "links", "provenance"],
  "additionalProperties": false
}
