{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entity": {
      "type": "string",
      "const": "task"
    },
    "schema_version": {
      "type": "string",
      "const": "pm.task.v1"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "ready", "in_progress", "blocked", "in_review", "done", "cancelled"]
        },
        "task_type": {
          "type": "string",
          "enum": ["implementation", "investigation", "migration", "testing", "review", "decision"]
        }
      },
      "required": ["title", "status", "task_type"],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "The technical goal, in one or two sentences. The one section a task cannot omit."
        },
        "implements": {
          "type": "object",
          "properties": {
            "stream_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "requirement_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
              }
            },
            "acceptance_criteria_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
              }
            }
          },
          "required": ["stream_id"],
          "additionalProperties": false,
          "description": "[task_references_business_requirements] A task at status ready or beyond must reference the business work it implements: content.implements.stream_id plus at least one requirement id or acceptance criterion id."
        },
        "technical_scope": {
          "type": "object",
          "properties": {
            "repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "services": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "data_models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          "additionalProperties": false
        },
        "implementation": {
          "type": "object",
          "properties": {
            "approach": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "technical_decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "decision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "alternatives_considered": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                },
                "required": ["decision", "reason"],
                "additionalProperties": false
              }
            }
          },
          "required": ["approach"],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "verification": {
          "description": "[ready_task_needs_definition_of_done] A task at status ready or beyond needs a technical definition of done: at least one entry in content.done_when and at least one in content.verification.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "unit_test",
                  "integration_test",
                  "e2e_test",
                  "manual_test",
                  "review",
                  "measurement"
                ]
              },
              "procedure": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "expected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["id", "type", "procedure", "expected"],
            "additionalProperties": false
          }
        },
        "done_when": {
          "description": "[ready_task_needs_definition_of_done] A task at status ready or beyond needs a technical definition of done: at least one entry in content.done_when and at least one in content.verification.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "required": ["objective"],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "parent_stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["parent_stream_id"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "user_input",
                  "conversation",
                  "existing_code",
                  "documentation",
                  "external_reference",
                  "inference"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "confidence": {
                "type": "string",
                "enum": ["explicit", "implied", "inferred", "assumed"]
              }
            },
            "required": ["type", "confidence"],
            "additionalProperties": false
          }
        },
        "inferred_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "created_from": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "created_by": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["user", "agent", "planner_agent", "executor_agent", "system"]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["type", "id"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "[unknowns_must_be_marked] Never write a guess as if the user had stated it. Anything unknown goes into content.open_questions, content.assumptions or provenance.inferred_fields, and provenance.sources records how firmly each source supports what was written."
    },
    "execution": {
      "type": "object",
      "properties": {
        "estimate": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "type": "string",
              "enum": ["minutes", "hours", "days", "points"]
            },
            "confidence": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "required": ["value", "unit"],
          "additionalProperties": false
        },
        "assignee": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["user", "agent", "planner_agent", "executor_agent", "system"]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["type", "id"],
          "additionalProperties": false
        },
        "execution_context": {
          "type": "object",
          "properties": {
            "environment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "additionalProperties": false
        },
        "long_running": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["entity", "schema_version", "meta", "content", "links", "provenance"],
  "additionalProperties": false
}
