{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entity": {
      "type": "string",
      "const": "stream"
    },
    "schema_version": {
      "type": "string",
      "const": "pm.stream.v2"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "planned", "ready", "in_progress", "blocked", "completed", "cancelled"]
        },
        "stream_type": {
          "type": "string",
          "const": "investigation"
        },
        "size": {
          "type": "string",
          "enum": ["small", "medium", "large"]
        }
      },
      "required": ["title", "status", "stream_type"],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "Why this stream exists, in business terms. The one section a stream cannot omit."
        },
        "scope": {
          "type": "object",
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^SCP-[1-9][0-9]*$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": ["stated", "verified", "inferred", "assumed"]
                      },
                      "source_ids": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^SRC-[1-9][0-9]*$"
                        }
                      }
                    },
                    "required": ["basis"],
                    "additionalProperties": false,
                    "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
                  }
                },
                "required": ["id", "statement"],
                "additionalProperties": false
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^SCP-[1-9][0-9]*$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": ["stated", "verified", "inferred", "assumed"]
                      },
                      "source_ids": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^SRC-[1-9][0-9]*$"
                        }
                      }
                    },
                    "required": ["basis"],
                    "additionalProperties": false,
                    "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
                  }
                },
                "required": ["id", "statement"],
                "additionalProperties": false
              }
            }
          },
          "required": ["included", "excluded"],
          "additionalProperties": false
        },
        "actor": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          "required": ["primary"],
          "additionalProperties": false
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^WF-[1-9][0-9]*$"
              },
              "workflow_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "actor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^STEP-[1-9][0-9]*$"
                    },
                    "action": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "result": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "evidence": {
                      "type": "object",
                      "properties": {
                        "basis": {
                          "type": "string",
                          "enum": ["stated", "verified", "inferred", "assumed"]
                        },
                        "source_ids": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^SRC-[1-9][0-9]*$"
                          }
                        }
                      },
                      "required": ["basis"],
                      "additionalProperties": false,
                      "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
                    }
                  },
                  "required": ["id", "action"],
                  "additionalProperties": false
                }
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["stated", "verified", "inferred", "assumed"]
                  },
                  "source_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^SRC-[1-9][0-9]*$"
                    }
                  }
                },
                "required": ["basis"],
                "additionalProperties": false,
                "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
              }
            },
            "required": ["id", "workflow_name", "steps"],
            "additionalProperties": false
          }
        },
        "rule_applications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^RA-[1-9][0-9]*$"
              },
              "rule_key": {
                "type": "string",
                "pattern": "^(?:R-[1-9][0-9]*|\\$[a-z][a-z0-9_]{0,39})$"
              },
              "applies_when": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "application": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["stated", "verified", "inferred", "assumed"]
                  },
                  "source_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^SRC-[1-9][0-9]*$"
                    }
                  }
                },
                "required": ["basis"],
                "additionalProperties": false,
                "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
              }
            },
            "required": ["id", "rule_key"],
            "additionalProperties": false
          }
        },
        "edge_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^EC-[1-9][0-9]*$"
              },
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "scenario": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "expected_behavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["stated", "verified", "inferred", "assumed"]
                  },
                  "source_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^SRC-[1-9][0-9]*$"
                    }
                  }
                },
                "required": ["basis"],
                "additionalProperties": false,
                "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
              }
            },
            "required": ["id", "trigger", "expected_behavior"],
            "additionalProperties": false
          }
        },
        "vertical_slice": {
          "type": "object",
          "properties": {
            "delivers_alone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "needs_no_other_stream": {
              "type": "boolean"
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "evidence": {
              "type": "object",
              "properties": {
                "basis": {
                  "type": "string",
                  "enum": ["stated", "verified", "inferred", "assumed"]
                },
                "source_ids": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^SRC-[1-9][0-9]*$"
                  }
                }
              },
              "required": ["basis"],
              "additionalProperties": false,
              "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
            }
          },
          "required": ["delivers_alone"],
          "additionalProperties": false
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^OQ-[1-9][0-9]*$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": ["id", "question"],
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ASM-[1-9][0-9]*$"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source_ids": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SRC-[1-9][0-9]*$"
                }
              }
            },
            "required": ["id", "statement"],
            "additionalProperties": false
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^IQ-[1-9][0-9]*$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "why_it_matters": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["stated", "verified", "inferred", "assumed"]
                  },
                  "source_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^SRC-[1-9][0-9]*$"
                    }
                  }
                },
                "required": ["basis"],
                "additionalProperties": false,
                "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
              }
            },
            "required": ["id", "question"],
            "additionalProperties": false
          }
        },
        "discovery_scope": {
          "type": "object",
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^SCP-[1-9][0-9]*$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": ["stated", "verified", "inferred", "assumed"]
                      },
                      "source_ids": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^SRC-[1-9][0-9]*$"
                        }
                      }
                    },
                    "required": ["basis"],
                    "additionalProperties": false,
                    "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
                  }
                },
                "required": ["id", "statement"],
                "additionalProperties": false
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^SCP-[1-9][0-9]*$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": ["stated", "verified", "inferred", "assumed"]
                      },
                      "source_ids": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^SRC-[1-9][0-9]*$"
                        }
                      }
                    },
                    "required": ["basis"],
                    "additionalProperties": false,
                    "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
                  }
                },
                "required": ["id", "statement"],
                "additionalProperties": false
              }
            }
          },
          "required": ["included", "excluded"],
          "additionalProperties": false
        },
        "success_criteria": {
          "description": "[success_criteria_may_replace_acceptance_criteria] An investigation or experiment stream may satisfy its success criterion with content.success_criteria or content.expected_decision instead of classic acceptance criteria, but it needs one of them to reach ready.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SC-[1-9][0-9]*$"
              },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "measurement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": ["stated", "verified", "inferred", "assumed"]
                  },
                  "source_ids": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^SRC-[1-9][0-9]*$"
                    }
                  }
                },
                "required": ["basis"],
                "additionalProperties": false,
                "description": "Claim provenance. stated, verified and inferred require at least one source_ids entry; assumed may omit it. Source ids resolve in this document's provenance.sources."
              }
            },
            "required": ["id", "criterion"],
            "additionalProperties": false
          }
        },
        "expected_decision": {
          "description": "The decision this investigation must enable. An investigation that decides nothing should not be a stream.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": ["purpose"],
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "properties": {
        "parent_epic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["parent_epic_id"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SRC-[1-9][0-9]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "user_input",
                  "conversation",
                  "existing_code",
                  "documentation",
                  "external_reference"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "snapshot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "supersedes_source_ids": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SRC-[1-9][0-9]*$"
                }
              }
            },
            "required": ["id", "type", "reference"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Immutable local Sources cited by claim evidence. Put uncertainty in addressable content assumptions or open_questions, never in inferred document paths."
    }
  },
  "required": ["entity", "schema_version", "meta", "content", "links", "provenance"],
  "additionalProperties": false
}
