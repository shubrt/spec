{
  "name": "@zpecs/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/_/index.ts",
      "default": "./src/_/index.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "schema:generate": "bun scripts/generateSchemas.ts --write",
    "schema:check": "bun scripts/generateSchemas.ts --check",
    "project:bootstrap": "bun --env-file=../../.env scripts/bootstrapProject.ts",
    "migrate:v2": "bun --env-file=../../.env scripts/migrateV2.ts",
    "db:deploy": "pnpm run db:setup:before && pnpm run db:push && pnpm run db:setup:after",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:setup:before": "bun --env-file=../../.env run node scripts/applyDatabaseSetup.mjs before",
    "db:setup:after": "bun --env-file=../../.env run node scripts/applyDatabaseSetup.mjs after"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@t3-oss/env-core": "catalog:",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.18",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tool/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.15.6",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
