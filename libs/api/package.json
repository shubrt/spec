{
  "name": "@zpecs/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/_/index.ts",
      "default": "./src/_/index.ts"
    }
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "schema:generate": "bun scripts/generateSchemas.ts --write",
    "schema:check": "bun scripts/generateSchemas.ts --check",
    "project:bootstrap": "bun --env-file=../../apps/web/.env scripts/bootstrapProject.ts",
    "db:push": "bun --env-file=../../apps/web/.env drizzle-kit push"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@t3-oss/env-core": "catalog:",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.18",
    "postgres": "^3.4.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tool/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
