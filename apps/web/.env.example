# One process hosts the TanStack app and the shared @zpecs/api Elysia app.
# Server functions call Elysia in-process; only /mcp and the two OAuth discovery
# endpoints are exposed over HTTP. Epic, Stream and Task writes remain MCP-only.
DATABASE_URL="postgres://zpecs:zpecs@localhost:5432/zpecs"

# Canonical public origin used for the MCP resource identifier and discovery
# URLs. Use the web origin with no path, query, fragment, or trailing slash.
# HTTP is allowed only for local loopback development; deployments need HTTPS.
ZPECS_PUBLIC_URL="http://localhost:3003"

# Clerk. These committed values stay placeholders. Put the canonical pair in
# apps/web/.env; it is shared by the web middleware and MCP authentication.
# On that tenant: enable Organizations, disable personal accounts, enable DCR,
# and set default scopes to openid/profile/email/user:org:read. The old
# fixed-port static client is optional; the web app needs no OAuth client ID,
# client secret, or callback-port variable. See SETUP.md at
# libs/api/src/integration/clerk/SETUP.md.
#
# VITE_-prefixed because the browser needs it: <ClerkProvider> reads it through
# import.meta.env. @clerk/tanstack-react-start prefers VITE_CLERK_PUBLISHABLE_KEY
# over CLERK_PUBLISHABLE_KEY on the server too, so one variable serves both sides.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace-me"

# Server-only. Clerk's request middleware reads it straight from process.env;
# it is declared in src/lib/env.ts so a missing key fails at boot with a clear
# message instead of per-request inside Clerk.
CLERK_SECRET_KEY="sk_test_replace-me"

# Optional structured request-event drain. Without both values, events go to
# the server console.
AXIOM_DATASET=""
AXIOM_TOKEN=""
