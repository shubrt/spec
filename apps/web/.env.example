# zpecs' read-only web window. It has NO database access by design: every read
# goes to @zpecs/api over HTTP through Eden Treaty, from a server function. There
# is deliberately no DATABASE_URL here.

# Origin of the zpecs API (apps/web). Server-only — deliberately not
# VITE_-prefixed, so the browser can never reach the API directly.
# 3001 = zpecs.api, 3002 = legacy project, 3003 = web, 3004 = zpecs web service.
ZPECS_API_URL="http://localhost:3004"

# Clerk. No instance is provisioned yet; both values below are placeholders that
# satisfy the key-format check and nothing else. Replace them with the real keys
# from the handover checklist at libs/api/src/integration/clerk/SETUP.md.
# Use the SAME Clerk instance as apps/web — the active organization is the
# workspace, and both halves must agree on which instance issues the session.
#
# VITE_-prefixed because the browser needs it: <ClerkProvider> reads it through
# import.meta.env. @clerk/tanstack-react-start prefers VITE_CLERK_PUBLISHABLE_KEY
# over CLERK_PUBLISHABLE_KEY on the server too, so one variable serves both sides.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace-me"

# Server-only. Clerk's request middleware reads it straight from process.env;
# it is declared in src/lib/env.ts so a missing key fails at boot with a clear
# message instead of per-request inside Clerk.
CLERK_SECRET_KEY="sk_test_replace-me"
