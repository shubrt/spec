{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "vp run --filter @spec/web build",
    "watchPatterns": [
      "/apps/web/**",
      "/libs/api/**",
      "/tools/typescript/**",
      "/.bun-version",
      "/.env.example",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/railway.json",
      "/vite.config.ts"
    ]
  },
  "deploy": {
    "preDeployCommand": "vp run --filter @spec/api db:deploy",
    "startCommand": "cd apps/web && bun --env-file=../../.env run node .output/server/index.mjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
